pipeline{
    agent {
        label 'dev'
    }
    stages{
        stage('Build - system details'){
            steps{
                sh '''
                echo ' "SYSTEM DETAILS" '
                uname -a
                '''
            }
        }
        stage('Build - Memory details'){
            steps{
                sh '''
                echo "MEMORYyy1 DETAILS"
                free
                '''
            }
        }
        stage('Build - CPU details'){
            steps{
                sh '''
                echo "CPU DETAILS"
                lscpu
                '''
            }
        }
        stage('Build - Disk details'){
            steps{
                sh '''
                echo "TODAYs DATE"
                date
                '''
            }
        }
        stage('Build-Process command'){
            steps{
                sh '''
                echo "Process command"
                ps -ef | head
                '''
            }
        }
    }
}